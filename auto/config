#!/bin/sh
# DadarecoOS: configuração do live-build (Debian 13 "trixie", amd64).
# ISO enxuta: só instalador + firmwares de rede. Desktop vem da internet na instalação.
set -e

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--binary-images iso-hybrid \
	--bootloaders "syslinux,grub-efi" \
	--debian-installer none \
	--archive-areas "main contrib non-free non-free-firmware" \
	--apt-recommends false \
	--iso-application "DadarecoOS" \
	--iso-volume "DadarecoOS" \
	--iso-publisher "DadarecoOS" \
	--bootappend-live "boot=live components quiet splash" \
	"${@}"

# ponytail: sem UEFI 32 bits (Bay Trail antigo às vezes tem). Adicionar grub-efi-ia32 se o HP precisar.
