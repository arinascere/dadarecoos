#!/bin/sh
# DadarecoOS: configuração do live-build (Debian 13 "trixie", amd64).
# ISO enxuta: instalador + firmwares. O desktop vem da internet durante a instalação.
set -e

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--binary-images iso-hybrid \
	--debian-installer none \
	--archive-areas "main contrib non-free non-free-firmware" \
	--apt-recommends false \
	--firmware-chroot false \
	--firmware-binary false \
	--memtest none \
	--iso-application "DadarecoOS" \
	--iso-volume "DadarecoOS" \
	--iso-publisher "DadarecoOS" \
	--bootappend-live "boot=live components quiet locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo" \
	"${@}"
